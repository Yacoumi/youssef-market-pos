<views:DialogWindow x:Class="MarketPos.Views.StaffSignInWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource Font.Base}"
        FlowDirection="RightToLeft"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.22" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <Border Width="48" Height="48" CornerRadius="15" Background="{StaticResource Brush.AccentSoft}"
                    HorizontalAlignment="Left" TextElement.Foreground="{StaticResource Brush.Accent}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.User}" Width="22" Height="22"/>
            </Border>

            <TextBlock x:Name="HeadingText" Text="Back office" Style="{StaticResource Text.Title}"
                       FontSize="19" Margin="0,16,0,0"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Text.Muted}" Margin="0,4,0,18"
                       TextWrapping="Wrap"
                       Text="What the back office shows depends on who you are, and everything saved there is recorded under your name."/>

            <TextBlock x:Name="NameLabel" Text="NAME" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,7"/>
            <!-- Editable: staff pick their name from the list, and the owner — who has no
                 staff row to be listed from — types theirs. -->
            <ComboBox x:Name="WorkerBox" Style="{StaticResource ComboBox.Form}" Height="42"
                      IsEditable="True" StaysOpenOnEdit="True" TextSearch.TextPath="Name"
                      ItemTemplate="{StaticResource Combo.Name}" SelectionChanged="Worker_Changed"/>

            <TextBlock x:Name="PasswordLabel" Text="PASSWORD" Style="{StaticResource Text.Eyebrow}"
                       Margin="2,16,0,7"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBox.Field}"/>

            <TextBlock x:Name="NoteText" Style="{StaticResource Text.Muted}" FontSize="12"
                       Margin="2,10,2,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock x:Name="ErrorText" FontSize="12" Margin="2,12,2,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Danger}"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self},
                                    Converter={StaticResource StrVis}}"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Button.PillMuted}" Content="Cancel"
                        Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Grid.Column="2" Style="{StaticResource Button.Pill}"
                        Content="Sign in" Click="SignIn_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</views:DialogWindow>
