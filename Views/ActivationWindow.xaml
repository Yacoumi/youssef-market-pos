<views:DialogWindow x:Class="MarketPos.Views.ActivationWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activation" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Font.Base}"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="28" Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.25" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <Image Source="pack://application:,,,/Assets/logo.png" Height="30" Stretch="Uniform"
                   HorizontalAlignment="Left" Margin="0,0,0,18"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock Text="Activate this computer" Style="{StaticResource Text.Title}" FontSize="19"/>
            <TextBlock Text="This copy is registered to one shop. Send the machine code to Homayk Studio to receive the activation key for this computer."
                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,18"/>

            <TextBlock Text="MACHINE CODE" Style="{StaticResource Text.FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MachineCodeBox" Grid.Column="0" Style="{StaticResource TextBox.Field}"
                         IsReadOnly="True" FontSize="15" FlowDirection="LeftToRight"/>
                <Button Grid.Column="2" Style="{StaticResource Button.PillMuted}" Content="Copy"
                        MinWidth="90" Click="Copy_Click"/>
            </Grid>

            <TextBlock Text="ACTIVATION KEY" Style="{StaticResource Text.FieldLabel}" Margin="2,16,0,6"/>
            <TextBox x:Name="KeyBox" Style="{StaticResource TextBox.Field}" FontSize="15"
                     FlowDirection="LeftToRight" CharacterCasing="Upper"/>

            <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Body}" FontSize="12.5"
                       Foreground="{StaticResource Brush.Danger}" Margin="2,12,2,0" TextWrapping="Wrap"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self},
                                    Converter={StaticResource StrVis}}"/>

            <Grid Margin="0,22,0,0">
                <Button Style="{StaticResource Button.PillMuted}" Content="Close"
                        HorizontalAlignment="Left" Width="110" Click="Close_Click"/>
                <Button Style="{StaticResource Button.Pill}" Content="Activate"
                        HorizontalAlignment="Right" MinWidth="160" Click="Activate_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</views:DialogWindow>
