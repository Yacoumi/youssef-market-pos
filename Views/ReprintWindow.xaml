<views:DialogWindow x:Class="MarketPos.Views.ReprintWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعادة طباعة الإيصال" Width="520" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.25" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Reprint Receipt" Style="{StaticResource Text.Title}" FontSize="20"/>
                <TextBlock Text="Enter the receipt number printed on a completed sale. Nothing is charged again."
                           Style="{StaticResource Text.Muted}" Margin="0,4,0,16"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NumberBox" Grid.Column="0" Style="{StaticResource TextBox.Plain}"
                         FontSize="20" Padding="14,11"
                         PreviewTextInput="NumberBox_PreviewTextInput" KeyDown="NumberBox_KeyDown"/>
                <Button Grid.Column="1" Style="{StaticResource Button.PillMuted}" Content="Find"
                        Margin="10,0,0,0" Click="Find_Click"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="RECENT RECEIPTS" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,8"/>
                <ItemsControl x:Name="RecentList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <Border Grid.Row="3" Background="{StaticResource Brush.Card}" CornerRadius="14" Padding="10">
                <Grid>
                    <TextBlock x:Name="EmptyText" Text="Enter a receipt number to see it here"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                               Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border x:Name="PreviewTray" Background="White" CornerRadius="8" Padding="6"
                            Width="292" HorizontalAlignment="Center" Visibility="Collapsed">
                        <FlowDocumentScrollViewer x:Name="Preview"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  IsSelectionEnabled="False"
                                                  Background="White" Padding="0"/>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Style="{StaticResource Button.PillMuted}" Content="Close" MinWidth="120" Click="Close_Click"/>
                <Button x:Name="PrintButton" Style="{StaticResource Button.Pill}" Content="Reprint Receipt"
                        MinWidth="180" Margin="12,0,0,0" IsEnabled="False" Click="Print_Click"/>
            </StackPanel>

        </Grid>
    </Border>
</views:DialogWindow>
