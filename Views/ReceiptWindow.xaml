<views:DialogWindow x:Class="MarketPos.Views.ReceiptWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt" Width="440" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.25" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Title}" FontSize="20"/>
                <TextBlock x:Name="SubText" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Outer tray is the grey backdrop; the white receipt sits centred on it at the
                 real roll width, so it reads like an actual ticket instead of a left-aligned
                 block of text. -->
            <Border Grid.Row="1" Background="{StaticResource Brush.Card}" CornerRadius="14" Padding="10">
                <Border Background="White" CornerRadius="8" Padding="6"
                        Width="292" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                    <FlowDocumentScrollViewer x:Name="Preview"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsSelectionEnabled="False"
                                              Background="White" Padding="0"
                                              HorizontalAlignment="Center"/>
                </Border>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Style="{StaticResource Button.PillMuted}" Content="Done" MinWidth="120" Click="Close_Click"/>
                <Button x:Name="PrintButton" Style="{StaticResource Button.Pill}" MinWidth="160"
                        Margin="12,0,0,0" Click="Print_Click"/>
            </StackPanel>

        </Grid>
    </Border>
</views:DialogWindow>
