<views:DialogWindow x:Class="MarketPos.Views.ScanWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مسح الباركود" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource Font.Base}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="28">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.22" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center">
            <!-- The scanner is a keyboard, so there is nothing to watch for. The pulse is the
                 only thing telling the cashier the till is listening. -->
            <Border Width="72" Height="72" CornerRadius="24" HorizontalAlignment="Center"
                    Background="{StaticResource Brush.AccentSoft}"
                    TextElement.Foreground="{StaticResource Brush.Accent}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="Pulse" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="ScaleX"
                                                 To="1.08" Duration="0:0:0.9"
                                                 EasingFunction="{StaticResource Ease.Out}"/>
                                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="ScaleY"
                                                 To="1.08" Duration="0:0:0.9"
                                                 EasingFunction="{StaticResource Ease.Out}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Search}"
                      Width="30" Height="30" StrokeThickness="1.9"/>
            </Border>

            <TextBlock Text="Scan the product" Style="{StaticResource Text.Title}" FontSize="19"
                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,6,0,0" MaxWidth="280" TextWrapping="Wrap"
                       Text="Point the scanner at the barcode. You can also type it below."/>

            <TextBox x:Name="CodeBox" Style="{StaticResource TextBox.Field}" Height="46" Width="300"
                     Margin="0,18,0,0" FontSize="17" TextAlignment="Center"
                     KeyDown="Code_KeyDown"/>

            <Grid Margin="0,20,0,0" Width="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Button.PillMuted}" Content="Cancel"
                        Click="Cancel_Click"/>
                <Button Grid.Column="2" Style="{StaticResource Button.Pill}" Content="Use code"
                        Click="Use_Click"/>
            </Grid>

            <!-- Loose produce, bread, anything sold from a crate. The till makes an in-store
                 code for it, so the cashier never has to invent one. -->
            <TextBlock Text="This product has no barcode" HorizontalAlignment="Center"
                       Margin="0,16,0,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                       Foreground="{StaticResource Brush.Accent}"
                       MouseLeftButtonDown="NoBarcode_Click"/>
        </StackPanel>
    </Border>
</views:DialogWindow>
