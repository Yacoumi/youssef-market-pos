<!-- Finds the printers the shop has plugged in or put on its network, and installs them.
     Written in English, the source text the translator looks every label up by. -->
<views:DialogWindow x:Class="MarketPos.Views.PrinterScanWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find printers" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.25" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Find printers" Style="{StaticResource Text.Title}" FontSize="20"/>
            <TextBlock Text="Plug the printer in or connect it to the shop's network, then scan. Installing sets it up in Windows and installs its driver."
                       Style="{StaticResource Text.Muted}" Margin="0,4,0,16" TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ScanButton" Grid.Column="0" Style="{StaticResource Button.Pill}"
                        Content="Scan" MinWidth="110" Height="40" Click="Scan_Click"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource Text.Muted}"
                           FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>

            <ScrollViewer MaxHeight="340" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="FoundList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.Card}" CornerRadius="12"
                                    Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}"
                                                   FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Button.PillMuted}"
                                            Content="{Binding Action}" MinWidth="96" Height="36"
                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                            Tag="{Binding}" Click="Act_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DriverFileButton" Grid.Column="0" Style="{StaticResource Button.PillMuted}"
                        Content="Install a driver from a file" Click="DriverFile_Click"/>
                <Button Grid.Column="2" Style="{StaticResource Button.PillMuted}"
                        Content="Windows printers" Click="WindowsPrinters_Click"/>
                <Button Grid.Column="4" Style="{StaticResource Button.Pill}" Content="Close"
                        Click="Close_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</views:DialogWindow>
