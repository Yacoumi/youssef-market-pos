<views:DialogWindow x:Class="MarketPos.Views.Admin.PurchaseWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarketPos.Views.Admin"
        Title="Record a delivery" Width="780" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource Font.Base}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="18">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.22" BlurRadius="34" ShadowDepth="10" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Record a delivery" Style="{StaticResource Text.Title}"/>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Everything on one invoice goes in together. Stock goes up when you save; money only leaves for what you actually pay."/>
                </StackPanel>
                <Button Style="{StaticResource Button.RowAction}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Cancel_Click">
                    <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Close}"/>
                </Button>
            </Grid>

            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SUPPLIER" Style="{StaticResource Text.FieldLabel}"/>
                            <ComboBox x:Name="SupplierBox" Style="{StaticResource ComboBox.Form}" ItemTemplate="{StaticResource Combo.Name}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="INVOICE NUMBER" Style="{StaticResource Text.FieldLabel}"/>
                            <TextBox x:Name="InvoiceBox" Style="{StaticResource TextBox.Field}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="DELIVERED ON" Style="{StaticResource Text.FieldLabel}"/>
                            <DatePicker x:Name="DateBox" Style="{StaticResource DatePicker.Field}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="PAYMENT DUE" Style="{StaticResource Text.FieldLabel}"/>
                            <DatePicker x:Name="DueBox" Style="{StaticResource DatePicker.Field}"/>
                        </StackPanel>
                    </Grid>

                    <local:DeliveryEditor x:Name="Editor" Problem="Editor_Problem"
                                          Changed="Editor_Changed"/>

                    <Border Style="{StaticResource Rule}" Margin="0,10,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PAID NOW" Style="{StaticResource Text.FieldLabel}"/>
                                    <TextBox x:Name="PaidBox" Style="{StaticResource TextBox.Field}"
                                             TextChanged="Paid_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PAID BY" Style="{StaticResource Text.FieldLabel}"/>
                                    <ComboBox x:Name="MethodBox" Style="{StaticResource ComboBox.Form}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="NOTE (OPTIONAL)" Style="{StaticResource Text.FieldLabel}" Margin="2,10,0,4"/>
                            <TextBox x:Name="NoteBox" Style="{StaticResource TextBox.Field}"/>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource Card.Inner}" MinWidth="220" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="INVOICE TOTAL" Style="{StaticResource Text.Eyebrow}"/>
                                <TextBlock x:Name="TotalText" Style="{StaticResource Text.Stat}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="OwingText" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Body}" FontSize="12.5"
                               Foreground="{StaticResource Brush.Danger}" Margin="2,10,2,0" TextWrapping="Wrap"
                               Visibility="{Binding Text, RelativeSource={RelativeSource Self},
                                            Converter={StaticResource StrVis}}"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Margin="0,14,0,0">
                <Button Style="{StaticResource Button.PillMuted}" Content="Cancel"
                        HorizontalAlignment="Left" Width="110" Click="Cancel_Click"/>
                <Button Style="{StaticResource Button.Pill}" Content="Save delivery"
                        HorizontalAlignment="Right" Width="180" Click="Save_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</views:DialogWindow>
