<Window x:Class="MarketPos.Views.Admin.AmountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Amount" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource Font.Base}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.22" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Title}"/>
            <TextBlock x:Name="BlurbText" Style="{StaticResource Text.Muted}" Margin="0,4,0,18"
                       TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="AmountLabel" Text="AMOUNT" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBox x:Name="AmountBox" Style="{StaticResource TextBox.Field}"/>
                </StackPanel>
                <StackPanel x:Name="DateSection" Grid.Column="2">
                    <TextBlock Text="DATE" Style="{StaticResource Text.FieldLabel}"/>
                    <DatePicker x:Name="DateBox" Style="{StaticResource DatePicker.Field}"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="MethodSection" Margin="0,16,0,0">
                <TextBlock Text="PAID BY" Style="{StaticResource Text.FieldLabel}"/>
                <ComboBox x:Name="MethodBox" Style="{StaticResource ComboBox.Form}"/>
            </StackPanel>

            <StackPanel x:Name="NoteSection">
                <TextBlock Text="NOTE (OPTIONAL)" Style="{StaticResource Text.FieldLabel}" Margin="2,16,0,6"/>
                <TextBox x:Name="NoteBox" Style="{StaticResource TextBox.Field}"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Body}" FontSize="12.5"
                       Foreground="{StaticResource Brush.Danger}" Margin="2,14,2,0" TextWrapping="Wrap"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self},
                                    Converter={StaticResource StrVis}}"/>

            <Grid Margin="0,22,0,0">
                <Button Style="{StaticResource Button.PillMuted}" Content="Cancel"
                        HorizontalAlignment="Left" Width="110" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource Button.Pill}"
                        HorizontalAlignment="Right" MinWidth="160" Click="Save_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
