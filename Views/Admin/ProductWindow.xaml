<!-- Add or edit a product.

     The same short form as the Add product page, because it asks the same questions: what it
     is, what the shop paid, what it sells for, and how many there are. Everything else a
     product carries (VAT bracket, minimum stock, shelf, supplier) keeps its value on an edit
     and takes the shop's default on a new one. -->
<Window x:Class="MarketPos.Views.Admin.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarketPos.Views.Admin"
        Title="Product" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Base}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="24,20">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.22" BlurRadius="34" ShadowDepth="10" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <Grid Margin="0,0,0,16">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Title}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Style="{StaticResource Button.RowAction}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Cancel_Click" ToolTip="Close">
                    <Path Style="{StaticResource Icon.Small}" Data="{StaticResource Icon.Close}"/>
                </Button>
            </Grid>

            <!-- Barcode -->
            <StackPanel x:Name="BarcodeRow">
                <TextBlock Text="BARCODE" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BarcodeBox" Grid.Column="0" Height="40"
                             Style="{StaticResource TextBox.Field}" FontSize="14"
                             TextChanged="Barcode_Changed"/>
                    <Button Grid.Column="2" Style="{StaticResource Button.PillMuted}" Height="40"
                            MinWidth="128" Content="No barcode" Click="NoBarcode_Click"
                            ToolTip="For goods with nothing printed on them"/>
                </Grid>
            </StackPanel>

            <Border x:Name="NoBarcodeNote" Style="{StaticResource Card.Inner}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Style="{StaticResource Text.Muted}"
                               Text="No barcode. The cashier presses its picture at the till."/>
                    <Button Grid.Column="1" Style="{StaticResource Button.SmallMuted}"
                            Content="It has one" Click="HasBarcode_Click"/>
                </Grid>
            </Border>

            <!-- Name, category, photo -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="NAME" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,7"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Field}" Height="40"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="CATEGORY" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,7"/>
                    <ComboBox x:Name="CategoryBox" Style="{StaticResource ComboBox.Form}"
                              Height="40" IsEditable="True"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="PHOTO" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,7"/>
                    <Button Style="{StaticResource Button.Card}" Width="86" Height="40"
                            Padding="0" Click="Picture_Click"
                            ToolTip="Choose a photo for this product">
                        <Grid>
                            <Image x:Name="PictureBox" Stretch="UniformToFill" Margin="2"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,82,36" RadiusX="8" RadiusY="8"/>
                                </Image.Clip>
                            </Image>
                            <StackPanel x:Name="PicturePrompt" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Style="{StaticResource Icon.Small}"
                                      Data="{StaticResource Icon.Plus}" Width="12" Height="12"
                                      Fill="{StaticResource Brush.Muted}"/>
                                <TextBlock Text="Add" Style="{StaticResource Text.Muted}"
                                           FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- How it is sold -->
            <TextBlock Text="SOLD" Style="{StaticResource Text.Eyebrow}" Margin="2,16,0,7"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="UnitBox" Grid.Column="0" Style="{StaticResource ComboBox.Form}"
                          Height="40" SelectionChanged="Unit_Changed"/>
            </Grid>

            <!-- Money and quantity -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="CostLabel" Text="BOUGHT FOR"
                               Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,7"/>
                    <TextBox x:Name="CostBox" Style="{StaticResource TextBox.Field}" Height="40"
                             local:Numeric.Only="True" TextChanged="Amount_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="PriceLabel" Text="SELLING FOR"
                               Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,7"/>
                    <TextBox x:Name="PriceBox" Style="{StaticResource TextBox.Field}" Height="40"
                             local:Numeric.Only="True" TextChanged="Amount_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock x:Name="QuantityLabel" Text="QUANTITY"
                               Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,7"/>
                    <TextBox x:Name="QuantityBox" Style="{StaticResource TextBox.Field}" Height="40"
                             local:Numeric.Only="True" TextChanged="Amount_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="EXPIRES ON" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,7"/>
                    <DatePicker x:Name="ExpiryBox" Style="{StaticResource DatePicker.Field}" Height="40"/>
                </StackPanel>
            </Grid>

            <!-- Shown on an edit: what is on the shelf now, so the quantity above reads as
                 "how many more arrived" rather than a number to overwrite. -->
            <TextBlock x:Name="InStockText" Style="{StaticResource Text.Muted}" FontSize="12"
                       Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <Border Style="{StaticResource Card.Inner}" Margin="0,16,0,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL COST" Style="{StaticResource Text.Eyebrow}"/>
                        <TextBlock x:Name="TotalCostText" Style="{StaticResource Text.Title}"
                                   FontSize="17" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PROFIT PER SALE" Style="{StaticResource Text.Eyebrow}"/>
                        <TextBlock x:Name="MarginText" Style="{StaticResource Text.Title}"
                                   FontSize="17" Margin="0,5,0,0"
                                   Foreground="{StaticResource Brush.Accent}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="ErrorText" FontSize="12.5" Margin="2,12,2,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Danger}"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self},
                                    Converter={StaticResource StrVis}}"/>

            <Grid Margin="0,20,0,0">
                <Button Style="{StaticResource Button.PillMuted}" Content="Cancel"
                        HorizontalAlignment="Left" Width="110" Height="42"
                        Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Style="{StaticResource Button.Pill}"
                        Content="Save product" HorizontalAlignment="Right" MinWidth="180"
                        Height="42" FontSize="14" Click="Save_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
