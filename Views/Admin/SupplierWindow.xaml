<views:DialogWindow x:Class="MarketPos.Views.Admin.SupplierWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supplier" Width="520" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource Font.Base}">

    <!-- The frame only. The form inside is SupplierForm, the same one the Suppliers page
         shows in place when a supplier is added; it is put in here from code. -->
    <Border x:Name="Card" CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="18">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.22" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>
    </Border>
</views:DialogWindow>
