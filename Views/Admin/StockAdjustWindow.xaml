<views:DialogWindow x:Class="MarketPos.Views.Admin.StockAdjustWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust stock" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource Font.Base}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.22" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Title}"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Text.Muted}" Margin="0,4,0,18"/>

            <!-- Two ways to say the same thing: "12 more arrived" or "I counted 47". -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="ModeChange" Style="{StaticResource Button.DateChip}" Content="Add or remove"
                             IsChecked="True" Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeCount" Style="{StaticResource Button.DateChip}" Content="Set counted total"
                             Checked="Mode_Changed"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="QuantityLabel" Text="QUANTITY" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBox x:Name="QuantityBox" Style="{StaticResource TextBox.Field}"
                             TextChanged="Quantity_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="REASON" Style="{StaticResource Text.FieldLabel}"/>
                    <ComboBox x:Name="ReasonBox" Style="{StaticResource ComboBox.Form}"
                              SelectionChanged="Quantity_Changed"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="NOTE (OPTIONAL)" Style="{StaticResource Text.FieldLabel}" Margin="2,16,0,6"/>
            <TextBox x:Name="NoteBox" Style="{StaticResource TextBox.Field}"/>

            <Border Style="{StaticResource Card.Inner}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="PreviewText" Style="{StaticResource Text.Cell}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ValueText" Style="{StaticResource Text.CellMuted}" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Body}" FontSize="12.5"
                       Foreground="{StaticResource Brush.Danger}" Margin="2,14,2,0" TextWrapping="Wrap"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self},
                                    Converter={StaticResource StrVis}}"/>

            <Grid Margin="0,22,0,0">
                <Button Style="{StaticResource Button.PillMuted}" Content="Cancel"
                        HorizontalAlignment="Left" Width="110" Click="Cancel_Click"/>
                <Button Style="{StaticResource Button.Pill}" Content="Save movement"
                        HorizontalAlignment="Right" Width="170" Click="Save_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</views:DialogWindow>
