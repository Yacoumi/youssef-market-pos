<views:DialogWindow x:Class="MarketPos.Views.Admin.WorkerWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Worker" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource Font.Base}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="18">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.22" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Title}"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Text.Muted}" Margin="0,4,0,18" TextWrapping="Wrap"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="NAME" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Field}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ROLE" Style="{StaticResource Text.FieldLabel}"/>
                    <ComboBox x:Name="RoleBox" Style="{StaticResource ComboBox.Form}"
                              SelectionChanged="Role_Changed"/>
                </StackPanel>
            </Grid>

            <Border x:Name="RoleNote" Style="{StaticResource Card.Inner}" Margin="0,10,0,0">
                <TextBlock x:Name="RoleNoteText" Style="{StaticResource Text.CellMuted}" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PHONE" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBox x:Name="PhoneBox" Style="{StaticResource TextBox.Field}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="EMAIL" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBox x:Name="EmailBox" Style="{StaticResource TextBox.Field}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="STARTED ON" Style="{StaticResource Text.FieldLabel}"/>
                    <DatePicker x:Name="StartedBox" Style="{StaticResource DatePicker.Field}"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="SalarySection" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SALARY" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox x:Name="SalaryBox" Style="{StaticResource TextBox.Field}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PAID" Style="{StaticResource Text.FieldLabel}"/>
                        <ComboBox x:Name="PeriodBox" Style="{StaticResource ComboBox.Form}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <TextBlock Text="NOTES" Style="{StaticResource Text.FieldLabel}" Margin="2,16,0,6"/>
            <TextBox x:Name="NoteBox" Style="{StaticResource TextBox.Multiline}"/>

            <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Body}" FontSize="12.5"
                       Foreground="{StaticResource Brush.Danger}" Margin="2,14,2,0" TextWrapping="Wrap"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self},
                                    Converter={StaticResource StrVis}}"/>

            <Grid Margin="0,14,0,0">
                <Button x:Name="ActiveButton" Style="{StaticResource Button.PillMuted}"
                        HorizontalAlignment="Left" Width="128" Click="ToggleActive_Click"
                        Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.PillMuted}" Content="Cancel" Width="100"
                            Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource Button.Pill}" Content="Save" Width="130" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</views:DialogWindow>
