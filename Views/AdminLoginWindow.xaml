<views:DialogWindow x:Class="MarketPos.Views.AdminLoginWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MarketPos.Converters"
        Title="Admin" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <views:DialogWindow.Resources>
        <conv:StringToVisibilityConverter x:Key="StrVis"/>
    </views:DialogWindow.Resources>

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.25" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource Brush.AccentSoft}"
                    HorizontalAlignment="Left" TextElement.Foreground="{StaticResource Brush.Accent}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Lock}" Width="24" Height="24"/>
            </Border>

            <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Title}" FontSize="20" Margin="0,16,0,0"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Text.Muted}" Margin="0,4,0,18" TextWrapping="Wrap"/>

            <StackPanel x:Name="PasswordSection">
                <TextBlock x:Name="FirstLabel" Text="PASSWORD" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,8"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBox.Field}"/>

                <StackPanel x:Name="ConfirmSection" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource Text.Eyebrow}" Margin="2,0,0,8"/>
                    <PasswordBox x:Name="ConfirmBox" Style="{StaticResource PasswordBox.Field}"/>
                </StackPanel>

                <Button x:Name="ForgotPasswordButton"
                        Style="{StaticResource Button.RowAction}"
                        HorizontalAlignment="Left" Margin="2,8,0,0"
                        Click="ForgotPassword_Click">
                    <TextBlock Text="Forgot password?" Foreground="{StaticResource Brush.Accent}"
                               TextDecorations="Underline" FontSize="12.5"/>
                </Button>
            </StackPanel>

            <TextBlock x:Name="ErrorText" FontSize="12" Margin="2,12,2,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Danger}"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StrVis}}"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Button.PillMuted}" Content="Cancel" Click="Cancel_Click"/>
                <Button Grid.Column="2" x:Name="SubmitButton" Style="{StaticResource Button.Pill}" Click="Submit_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</views:DialogWindow>
