<views:DialogWindow x:Class="MarketPos.Views.DiscountWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="خصم" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.25" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Discount" Style="{StaticResource Text.Title}" FontSize="20"/>
            <TextBlock Text="A discount for a regular customer" Style="{StaticResource Text.Muted}" Margin="0,4,0,16"/>

            <UniformGrid Columns="2" Rows="1" Margin="0,0,0,16">
                <ToggleButton x:Name="PercentButton" Style="{StaticResource Button.TogglePill}"
                              IsChecked="True" Margin="0,0,5,0" Checked="Percent_Checked">
                    <TextBlock Text="Percent  %"/>
                </ToggleButton>
                <ToggleButton x:Name="FixedButton" Style="{StaticResource Button.TogglePill}"
                              Margin="5,0,0,0" Checked="Fixed_Checked">
                    <TextBlock Text="Amount  DH"/>
                </ToggleButton>
            </UniformGrid>

            <TextBlock x:Name="FieldLabel" Text="Discount percentage" Style="{StaticResource Text.Muted}" Margin="0,0,0,6"/>
            <TextBox x:Name="ValueBox" Style="{StaticResource TextBox.Plain}" FontSize="24" Padding="16,12"
                     TextChanged="ValueBox_TextChanged" PreviewTextInput="ValueBox_PreviewTextInput"/>

            <Border Background="{StaticResource Brush.Card}" CornerRadius="14" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Subtotal" Style="{StaticResource Text.Muted}"/>
                        <TextBlock x:Name="GrossText" Grid.Column="1" Style="{StaticResource Text.Body}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DiscountLabelText" Text="Discount" Style="{StaticResource Text.Muted}"/>
                        <TextBlock x:Name="DiscountText" Grid.Column="1" Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.Danger}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total" Style="{StaticResource Text.Title}" FontSize="16"/>
                        <TextBlock x:Name="TotalText" Grid.Column="1" Style="{StaticResource Text.Title}" FontSize="16"
                                   Foreground="{StaticResource Brush.Accent}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="RemoveButton" Style="{StaticResource Button.PillMuted}"
                        Content="Remove" Margin="0,0,12,0" Click="Remove_Click"/>
                <Button Grid.Column="1" Style="{StaticResource Button.PillMuted}" Content="Cancel" Click="Cancel_Click"/>
                <Button Grid.Column="3" x:Name="ApplyButton" Style="{StaticResource Button.Pill}"
                        Content="Apply" Click="Apply_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</views:DialogWindow>
