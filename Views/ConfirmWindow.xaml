<views:DialogWindow x:Class="MarketPos.Views.ConfirmWindow"
        xmlns:views="clr-namespace:MarketPos.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border CornerRadius="20" Background="{StaticResource Brush.Panel}" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#1B2126" Opacity="0.25" BlurRadius="30" ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Title}" FontSize="18" TextWrapping="Wrap"/>
            <TextBlock x:Name="BodyText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Button.PillMuted}" Content="No" Click="No_Click"/>
                <Button Grid.Column="2" Style="{StaticResource Button.Pill}" Content="Yes" Click="Yes_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</views:DialogWindow>
