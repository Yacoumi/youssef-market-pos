<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything the shop knows, with no screen attached.

       Split out so the same code can run in three places: the till, the back office, and the
       server that owns the database. A rule about money that lived only in the WPF project
       could not be enforced by the server, and a second copy of it on the server would be a
       second answer to the same question. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MarketPos</RootNamespace>
    <AssemblyName>MarketPos.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- The web types, for the handful of files that describe what the shop's server answers.
       The library does not host anything; both servers do. What lives here is the shape of the
       answers and the check that a request is allowed to ask, written once so the standalone
       server and the all-in-one cannot enforce it differently. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <!-- The activation secret, compiled in from license.secret (see Directory.Build.props). -->
  <ItemGroup Condition="'$(LicenseSecret)' != ''">
    <AssemblyMetadata Include="MarketPos.Activation" Value="$(LicenseSecret)" />
  </ItemGroup>

  <!-- A release built without the secret would run on any computer, so it is refused. -->
  <Target Name="RequireActivationSecret" BeforeTargets="CoreCompile"
          Condition="'$(Configuration)' == 'Release' And '$(LicenseSecret)' == ''">
    <Error Text="license.secret is missing next to Directory.Build.props. A release build needs it so copies only run on activated computers." />
  </Target>

</Project>
