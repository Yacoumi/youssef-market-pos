<Application x:Class="MarketPos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MarketPos.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters live at application scope so the back-office pages, which are
                 UserControls rather than Windows, can reach them without each one
                 redeclaring the same four instances. -->
            <conv:MoneyConverter x:Key="Money"/>
            <conv:SignedMoneyConverter x:Key="SignedMoney"/>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolVis"/>
            <conv:StringToVisibilityConverter x:Key="StrVis"/>
            <conv:InverseStringToVisibilityConverter x:Key="InvStrVis"/>
            <conv:ImagePathConverter x:Key="ProductImage"/>
            <conv:CategoryNameConverter x:Key="CategoryName"/>
            <conv:TranslateConverter x:Key="Translate"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Theme.xaml"/>
                <ResourceDictionary Source="Theme/Icons.xaml"/>
                <!-- Back-office styles. Loaded after Theme.xaml because they are built on
                     its tokens; nothing here redefines a brand colour. -->
                <ResourceDictionary Source="Theme/Admin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
