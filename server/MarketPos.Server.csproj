<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The shop's server.

       Runs on the back-office machine, owns marketpos.db, and answers the tills over the
       local network. Nothing here re-implements a rule: every endpoint calls the same
       repository the back office calls, so there is one answer to "what did this cost" and
       one place stock is decremented. -->

  <PropertyGroup>
    <!-- Windows: the server asks for its activation key in a small window before it starts. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MarketPos.Server</RootNamespace>
    <AssemblyName>POS-Server</AssemblyName>

    <!-- One file means one file.

         PublishSingleFile on its own leaves every native library loose beside the exe —
         wpfgfx_cor3.dll and PresentationNative_cor3.dll for the window, e_sqlite3.dll for the
         database. The shop is handed the exe and nothing else, and without these it cannot
         open a window or a database: WPF throws DllNotFoundException before anything is on
         screen, and SQLite throws out of a type initializer. Both look like the program
         closing itself the moment it is opened.

         This is what puts them inside the file. They are unpacked to a temp folder on first
         run, which is why that run is the slow one. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\MarketPos.Core.csproj" />
  </ItemGroup>

</Project>
